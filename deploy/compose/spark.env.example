# A GPU box next to gr8: a peer that fetches from the other boxes first,
# then from the NAS root. Copy to .env next to docker-compose.yml on each box,
# and run with gr8.yml. (On kindling-spark-os, use deploy/spark-os instead.)
MODEL_LOADER_MODE=peer
# The NAS and every other box, host:port. With mentatd on the boxes, set
# MODEL_LOADER_DISCOVERY=mentat and list only the NAS here.
MODEL_LOADER_PEERS=nas.lan:7762,192.0.2.2:7762,192.0.2.3:7762
#MODEL_LOADER_DISCOVERY=mentat
# With mentat discovery, reach each box first at its ConnectX addresses
# that this box's mentatd probes ok, rather than the LAN.
#MODEL_LOADER_MENTAT_PREFER_TAGS=connectx
# A file that is not there selects nothing: the box holds what gr8's
# requests ask for, and no more.
MODEL_LOADER_SELECTION=/var/lib/model-loader/selection.yaml
# Most the store may hold; fetches evict what no request needs and the
# fleet holds elsewhere.
MODEL_LOADER_DISK_BUDGET=90%
# gr8's launcher options (MODEL, PEERS, ...), as in gr8's docker/.env.
#GR8_ENV=/path/to/gr8/docker/.env
