# Copy to /etc/spark/model-loader.env on the box. Plain KEY=VALUE, no quotes,
# no inline comments after a value (same convention as /etc/spark/node.env).

# root, peer, or both. A single-box spark-os install should normally use
# "both": this box is its own complete deployment.
MODEL_LOADER_MODE=both

# host:port of other spark-os boxes on the LAN, comma-separated. Leave empty
# for a single-box install.
MODEL_LOADER_PEERS=

# Uncomment to override defaults (catalog.yaml path, store directory, listen
# address, discovery backend). spark-os ships a catalog at the path below by
# default; see docs/design.md for the schema.
#MODEL_LOADER_CATALOG=/etc/model-loader/catalog.yaml
#MODEL_LOADER_STORE=/var/lib/model-loader
#MODEL_LOADER_LISTEN=:7762
#MODEL_LOADER_DISCOVERY=static
#MODEL_LOADER_NODE_ID=
