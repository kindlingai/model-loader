# The NAS: the root, holding the master copy of every model in catalog.yaml.
# Copy to .env next to docker-compose.yml on the NAS.
MODEL_LOADER_MODE=root
# A host directory on the NAS's pool, rather than a docker volume.
MODEL_LOADER_STORE=/srv/models/model-loader
# The NAS fetches from the origin (Hugging Face) once; the Sparks pull from it.
# Needed for gated or private repos only.
#HF_TOKEN=
