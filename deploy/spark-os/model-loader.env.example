# Copy to /etc/spark/model-loader.env on the box. Plain KEY=VALUE, no quotes,
# no inline comments after a value (same convention as /etc/spark/node.env).
#
# As set here: a Spark that is a peer next to gr8, with a NAS as the root
# holding the master copy (the NAS runs deploy/compose with
# nas.env.example). For one box on its own, set MODEL_LOADER_MODE=both and
# leave MODEL_LOADER_PEERS and MODEL_LOADER_SELECTION empty.

# root, peer, or both.
MODEL_LOADER_MODE=peer

# The NAS's model-loader, host:port. The other Sparks come from mentatd.
MODEL_LOADER_PEERS=nas.lan:7762

# A file that is not there selects nothing: this box holds what gr8's
# requests ask for, and no more. Empty: every model in the catalog.
MODEL_LOADER_SELECTION=/var/lib/model-loader/selection.yaml

# Most the store may hold: bytes (500G, 2T) or a share of its filesystem.
# Fetches evict segments no request needs and the fleet holds elsewhere.
MODEL_LOADER_DISK_BUDGET=90%

# Uncomment to change the defaults.
#MODEL_LOADER_CATALOG=/etc/model-loader/catalog.yaml
#MODEL_LOADER_STORE=/var/lib/model-loader
#MODEL_LOADER_LISTEN=:7762
#MODEL_LOADER_LOCAL_LISTEN=unix:model-loader.sock
#MODEL_LOADER_DISCOVERY=mentat
#MODEL_LOADER_NODE_ID=

# Hugging Face token for gated or private repos. Only a root (or "both")
# box uses it.
#HF_TOKEN=

# Required to serve MODEL_LOADER_LOCAL_LISTEN on host:port: gr8 then sends it
# as MODEL_LOADER_LOCAL_TOKEN in its own environment. Unset, the unix socket
# has no token and its file mode is the boundary.
#MODEL_LOADER_LOCAL_TOKEN=
